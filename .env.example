# Copy this file to .env and fill in real values. Never commit .env itself.

# Backend API keys (used by Python scrapers)
NEWSAPI_KEY=your_newsapi_key_here
SERPAPI_KEY=your_serpapi_key_here

# Backend CORS (set on Render — comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=https://your-app.vercel.app

# Frontend (Vite) — set this in Vercel dashboard under Environment Variables
# Point to your deployed FastAPI backend (e.g. on Railway, Render, Fly.io)
# Leave empty to run in offline/demo mode (uses fallback data)
VITE_API_BASE_URL=https://your-backend-api.example.com
